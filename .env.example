# Safe configuration template — placeholder values only. Never commit a
# real .env with actual secrets; .gitignore already excludes .env,
# .env.local, and .env.*.local.

# --- Backend ---
PORT=8080
FRONTEND_URL=http://localhost:5173

# Local/dev database (SQLite via node:sqlite). Unset in production — see
# DATABASE_URL below, which is the intended production path once the
# backend's data-access layer is converted to use it (see
# backend/src/db/postgres/README.md for current status).
NETTLE_DB_PATH=./nettle.db

# PostgreSQL (prepared, not yet wired into the live app — see
# backend/src/db/postgres/README.md). Required to run
# `npm run db:migrate:postgres`.
DATABASE_URL=
DATABASE_SSL=disable
DATABASE_POOL_MAX=10

# Signs Nettle's own outbound webhook deliveries (Slack/PagerDuty/Splunk/
# Datadog/generic integrations) with HMAC-SHA256. No default — required in
# any environment that has outbound webhooks configured. Generate with:
# openssl rand -hex 32
NETTLE_WEBHOOK_SECRET=

# AES-256-GCM key (base64, must decode to exactly 32 bytes) used to encrypt
# third-party credentials at rest (e.g. a private repo access token for
# repo-based scans). No default. Generate with: openssl rand -base64 32
NETTLE_TOKEN_ENCRYPTION_KEY=

# Authenticates calls to the scheduled-digest trigger endpoint
# (POST /api/internal/digest). No default — the endpoint returns 503 if
# unset. Generate with: openssl rand -hex 32
CRON_SECRET=

# Scan execution
NETTLE_MAX_CONCURRENT_SCANS=2
NETTLE_SCAN_JOB_TIMEOUT_MS=600000

# --- Stripe billing (optional — billing endpoints return 503 without these) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_TIER1=
STRIPE_PRICE_TIER2=
BILLING_SUCCESS_URL=http://localhost:5173/billing/success
BILLING_CANCEL_URL=http://localhost:5173/billing/cancelled
BILLING_PORTAL_RETURN_URL=http://localhost:5173/settings

# --- Email (SMTP via nodemailer — verification, password reset, payment
# failure, alert notifications) ---
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Nettle <alerts@nettle.app>

# --- SMS (Twilio — Tier 2 alert delivery) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Override only for testing against a non-Twilio-compatible endpoint.
TWILIO_API_BASE=

# --- PagerDuty (optional, per-integration routing key can also be passed
# per-call — this is only the fallback default) ---
PAGERDUTY_ROUTING_KEY=

# --- Frontend (set at build time) ---
VITE_API_BASE_URL=http://localhost:8080
