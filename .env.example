# Nettle configuration — NAMES and safe placeholders only.
# Never commit real values. Production values come from AWS Secrets Manager
# (see infra/lib/api-stack.ts).

# --- Server ---
PORT=8080
# "production" makes the app refuse to start without DATABASE_URL, because
# SQLite in an App Runner container is discarded on every deployment.
NODE_ENV=development

# --- Database ---------------------------------------------------------------
# PRODUCTION: set DATABASE_URL. This is what selects PostgreSQL.
#   postgresql://<user>:<password>@<host>:5432/<database>
# Injected from Secrets Manager in production; never write a real one here.
# DATABASE_URL=

# LOCAL DEVELOPMENT AND TESTS: leave DATABASE_URL unset and SQLite is used.
# No database server is needed to run the test suite.
NETTLE_DB_PATH=./nettle.db

# To run locally against PostgreSQL instead (optional — matches production):
#   docker run -e POSTGRES_PASSWORD=<choose-a-local-password> -p 5432:5432 -d postgres:16
#   DATABASE_URL=postgresql://postgres:<local-password>@localhost:5432/nettle?sslmode=disable

# --- Stripe billing (billing endpoints return 503 without these) ------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BUILD=
STRIPE_PRICE_PROTECT=
BILLING_SUCCESS_URL=http://localhost:5173/billing/success
BILLING_CANCEL_URL=http://localhost:5173/billing/cancelled

# --- Email delivery (SES) ----------------------------------------------------
# Shared transport for password-reset and organization-invitation emails
# (src/notifications/email.ts, via @aws-sdk/client-sesv2). EMAIL_FROM_ADDRESS
# must be a verified SES sending identity (an address or domain) in the
# target AWS account/region — SES will reject sends from an unverified
# identity. AWS credentials are never set here; the SDK resolves them from
# the environment (an IAM role on App Runner, or local AWS CLI config).
EMAIL_FROM_ADDRESS=
# Until EMAIL_FROM_ADDRESS and the URL below are both set, password resets
# are generated and stored but not delivered. Tokens are never logged.
APP_PASSWORD_RESET_URL=
# Until EMAIL_FROM_ADDRESS and the URL below are both set, organization
# invitations are created (and can be accepted if the token is relayed some
# other way) but the email itself is not sent.
APP_ORGANIZATION_INVITE_URL=

# --- Frontend (build-time) --------------------------------------------------
VITE_API_BASE_URL=http://localhost:8080
