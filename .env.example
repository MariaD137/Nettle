# Safe configuration template — placeholder values only. Never commit a
# real .env with actual secrets; .gitignore already excludes .env,
# .env.local, and .env.*.local.

# --- Backend ---
PORT=8080
FRONTEND_URL=http://localhost:5173

# CORS: restricts which origins the API accepts browser requests from.
# Comma-separated for multiple (e.g. a staging + production frontend).
# Falls back to FRONTEND_URL above when unset. With neither set — local
# dev by default — the API reflects whatever origin asks, unrestricted.
CORS_ALLOWED_ORIGINS=

# PostgreSQL 16 — the backend's only database; there is no SQLite fallback.
# Required to start the server at all (it fails fast with a clear error if
# unset) and to run `npm run db:migrate:postgres` directly. See
# backend/src/db/postgres/README.md.
#   postgres://user:password@host:5432/dbname
DATABASE_URL=
# DATABASE_SSL=disable is only for a local Postgres with no TLS configured
# (e.g. local dev, docker run postgres:16) — never set this against a real
# production database.
DATABASE_SSL=disable
DATABASE_POOL_MAX=10
# REQUIRES AWS CONFIGURATION for production: DATABASE_URL becomes an RDS
# connection string retrieved from AWS Secrets Manager at runtime (see
# infra/ and AWS_GITHUB_DEPLOYMENT.md) — provisioning and connecting to a
# real RDS instance requires an AWS account and hasn't been done from this
# repository.

# Signs Nettle's own outbound webhook deliveries (Slack/PagerDuty/Splunk/
# Datadog/generic integrations) with HMAC-SHA256. No default — required in
# any environment that has outbound webhooks configured. Generate with:
# openssl rand -hex 32
NETTLE_WEBHOOK_SECRET=

# AES-256-GCM key (base64, must decode to exactly 32 bytes) used to encrypt
# third-party credentials at rest (e.g. a private repo access token for
# repo-based scans). No default. Generate with: openssl rand -base64 32
NETTLE_TOKEN_ENCRYPTION_KEY=

# Authenticates calls to the scheduled-digest and scheduled-retention-
# cleanup trigger endpoints (POST /api/internal/digest,
# POST /api/internal/retention/cleanup). No default — both endpoints
# return 503 if unset. Generate with: openssl rand -hex 32
CRON_SECRET=

# Data retention (days). Deletes rows older than the window when
# POST /api/internal/retention/cleanup is triggered (intended to run on a
# schedule — AWS EventBridge, App Runner cron, etc. — nothing in-process
# schedules it). A value of 0 disables deletion for that category. Never
# deletes accounts, projects, or subscription/billing records regardless
# of these settings.
RETENTION_EVENTS_DAYS=90
RETENTION_ALERTS_DAYS=180
RETENTION_SCANS_DAYS=365
RETENTION_WEBHOOK_EVENTS_DAYS=30

# Scan execution
NETTLE_MAX_CONCURRENT_SCANS=2
NETTLE_SCAN_JOB_TIMEOUT_MS=600000
# Memory ceiling (MB) for the worker_thread a scan job runs in. Real and
# enforced by V8/Node — but a resource-exhaustion mitigation, not a
# security sandbox (worker_threads share the host process's OS-level
# privileges). Only applies to the worker_thread scanner backend, below.
NETTLE_SCAN_WORKER_MAX_MEMORY_MB=512

# Scanner isolation backend (see backend/src/scanner/ISOLATION.md).
# Unset/anything other than "fargate" = worker_thread (the default above,
# no AWS dependency). "fargate" runs each scan as a disposable, isolated
# ECS Fargate task instead — a real process/microVM security boundary, not
# just a thread — but requires infra/lib/scanner-stack.ts to have actually
# been deployed first and every NETTLE_SCANNER_*/NETTLE_SCAN_INPUT_BUCKET
# value below to be set from its outputs (see api-stack.ts's scanner*
# props and bin/app.ts's REQUIRES AWS CONFIGURATION note). Leaving these
# unset is not a broken state — the app runs the worker_thread backend
# exactly as it does today.
# NETTLE_SCANNER_BACKEND=fargate
# NETTLE_SCANNER_CLUSTER_ARN=
# NETTLE_SCANNER_TASK_DEFINITION_ARN=
# NETTLE_SCANNER_SUBNET_IDS=
# NETTLE_SCANNER_SECURITY_GROUP_ID=
# NETTLE_SCAN_INPUT_BUCKET=
# NETTLE_SCANNER_CALLBACK_BASE_URL=
# NETTLE_SCANNER_TASK_TIMEOUT_MS=600000

# Comma-separated allowlist of account emails granted access to /api/admin/*
# (operator overview, metrics, failed scans, webhook failures). Re-read on
# every process start — removing an email here actually revokes access on
# next restart, not just stops re-granting it. Empty/unset means no admins.
NETTLE_ADMIN_EMAILS=

# Nettle's own operational alerting (backend/src/observability/opsAlert.ts)
# — distinct from the customer-facing Patrol alert channels above. Notifies
# an operator on an unhandled exception, a fatal startup failure, or a
# sustained run of Stripe webhook processing failures. Either or both may
# be set; both empty means alerting is a documented no-op, not a silent
# failure. NETTLE_OPS_ALERT_WEBHOOK_URL accepts any JSON-POST receiver
# (Slack incoming webhook, PagerDuty Events, a generic endpoint).
# REQUIRES AWS CONFIGURATION for the piece this can't cover on its own:
# detecting a crash loop across container restarts (this in-process state
# resets every restart) needs a CloudWatch Alarm on App Runner's own
# restart/health-check signal — see AWS_GITHUB_DEPLOYMENT.md.
NETTLE_OPS_ALERT_WEBHOOK_URL=
NETTLE_OPS_ALERT_EMAIL=

# --- Stripe billing (optional — billing endpoints return 503 without these) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_TIER1=
STRIPE_PRICE_TIER2=
BILLING_SUCCESS_URL=http://localhost:5173/billing/success
BILLING_CANCEL_URL=http://localhost:5173/billing/cancelled
BILLING_PORTAL_RETURN_URL=http://localhost:5173/settings

# --- Email (SMTP via nodemailer — verification, password reset, payment
# failure, alert notifications) ---
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Nettle <alerts@nettle.app>

# --- SMS (Twilio — Tier 2 alert delivery) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Override only for testing against a non-Twilio-compatible endpoint.
TWILIO_API_BASE=

# --- PagerDuty (optional, per-integration routing key can also be passed
# per-call — this is only the fallback default) ---
PAGERDUTY_ROUTING_KEY=

# --- Frontend (set at build time) ---
VITE_API_BASE_URL=http://localhost:8080
