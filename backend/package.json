{
  "name": "@nettle/backend",
  "version": "0.1.0",
  "description": "Nettle Tier 1 scan engine and API — scans AI-built apps for launch-readiness gaps",
  "main": "dist/index.js",
  "bin": {
    "nettle": "bin/nettle.js"
  },
  "scripts": {
    "build": "tsc && mkdir -p dist/scanner/semgrep-rules dist/scanner/osv-data dist/db/migrations && cp src/scanner/semgrep-rules/*.yaml dist/scanner/semgrep-rules/ && cp src/scanner/osv-data/*.db dist/scanner/osv-data/ && cp src/db/migrations/*.sql dist/db/migrations/",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "NETTLE_DB_PATH=:memory: node --import tsx --test test/*.test.ts",
    "lint": "tsc --noEmit",
    "lint:test": "tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "@aws-sdk/client-ecs": "^3.1138.0",
    "@aws-sdk/client-s3": "^3.1138.0",
    "@aws-sdk/client-sesv2": "^3.1138.0",
    "@aws-sdk/client-sqs": "^3.1140.0",
    "cors": "^2.8.6",
    "express": "^4.19.2",
    "helmet": "^8.3.0",
    "multer": "^2.0.0",
    "pg": "^8.23.0",
    "stripe": "^22.3.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
